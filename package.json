{
  "name": "gabriel-jabour-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vinext": "1.4.4",
    "vite": "^8.3.6",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "minimatch@^3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@>=7": "11.0.1",
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "type": "module"
}
